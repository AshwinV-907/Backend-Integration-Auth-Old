<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Task &mdash; <%= filename %></title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- TaskFlow Vanilla CSS Design System -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Top Navigation Bar -->
    <header class="navbar">
        <div class="container nav-inner">
            <div class="nav-brand">
                <a href="/" style="display:flex; align-items:center; gap:0.75rem;">
                    <div class="brand-icon">
                        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                        </svg>
                    </div>
                    <span class="brand-title">TaskFlow</span>
                </a>
                <span class="brand-badge">Editor</span>
            </div>

            <div class="nav-actions">
                <a href="/file/<%= encodeURIComponent(filename) %>" class="btn btn-secondary btn-sm">
                    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    View Task
                </a>
                <a href="/" class="btn btn-ghost btn-sm">Cancel</a>
            </div>
        </div>
    </header>

    <main class="container" style="flex: 1;">
        <div class="edit-layout">
            <!-- Breadcrumbs -->
            <nav class="breadcrumb-nav">
                <a href="/">Dashboard</a>
                <span>/</span>
                <a href="/file/<%= encodeURIComponent(filename) %>" style="font-family: var(--font-mono);"><%= filename %></a>
                <span>/</span>
                <span style="color: var(--text-primary);">Editor</span>
            </nav>

            <div class="detail-card">
                <div class="create-panel-header" style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 1.25rem; margin-bottom: 1.5rem;">
                    <div>
                        <h1 class="panel-title" style="font-size: 1.35rem;">
                            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color:var(--accent-primary);">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            Edit Task &amp; Content
                        </h1>
                        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                            Editing flat file: <span class="kbd" style="font-size:0.75rem;"><%= filename %></span>
                        </p>
                    </div>

                    <div class="panel-hint">
                        Shortcut: <span class="kbd">Ctrl</span> + <span class="kbd">S</span> to save
                    </div>
                </div>

                <form action="/edit" method="POST" id="editTaskForm">
                    <input type="hidden" name="previous" value="<%= filename %>">

                    <!-- Title / Filename Field -->
                    <div class="form-group">
                        <label for="newTitleInput" style="display:block; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.05em; font-weight:600; color:var(--text-secondary); margin-bottom:0.4rem;">
                            Task Title
                        </label>
                        <input 
                            type="text" 
                            name="new" 
                            id="newTitleInput"
                            class="input-field" 
                            value="<%= filename.replace(/\.txt$/, '') %>"
                            placeholder="Enter task title..." 
                            required
                            autocomplete="off"
                        >
                    </div>

                    <!-- Details / Markdown Content Field -->
                    <div class="form-group" style="margin-top: 1.25rem; margin-bottom: 0.5rem;">
                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.4rem;">
                            <label for="editDetailsInput" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.05em; font-weight:600; color:var(--text-secondary);">
                                Task Details &amp; Markdown Notes
                            </label>
                            
                            <div class="content-tabs" style="margin-bottom:0; border:none; padding-bottom:0;">
                                <button type="button" id="tabEditor" class="content-tab-btn active" onclick="toggleEditPreview('edit')">Editor</button>
                                <button type="button" id="tabPreview" class="content-tab-btn" onclick="toggleEditPreview('preview')">Live Preview</button>
                            </div>
                        </div>

                        <!-- Formatting Toolbar -->
                        <div class="editor-toolbar" id="editToolbar">
                            <button type="button" class="tool-btn" title="Bold" onclick="insertFormat('editDetailsInput', '**', '**')">
                                <strong>B</strong>
                            </button>
                            <button type="button" class="tool-btn" title="Italic" onclick="insertFormat('editDetailsInput', '*', '*')">
                                <em>I</em>
                            </button>
                            <button type="button" class="tool-btn" title="Code" onclick="insertFormat('editDetailsInput', '`', '`')">
                                &lt;/&gt;
                            </button>
                            <div class="toolbar-separator"></div>
                            <button type="button" class="tool-btn" title="Bullet List" onclick="insertFormat('editDetailsInput', '- ')">
                                &bull; List
                            </button>
                            <button type="button" class="tool-btn" title="Checkbox" onclick="insertFormat('editDetailsInput', '- [ ] ')">
                                &#9745; Todo
                            </button>
                            <button type="button" class="tool-btn" title="Quote" onclick="insertFormat('editDetailsInput', '> ')">
                                &ldquo; Quote
                            </button>
                        </div>

                        <textarea 
                            name="details" 
                            id="editDetailsInput" 
                            class="input-field textarea-field" 
                            style="min-height: 240px; font-family: var(--font-mono); font-size: 0.9rem;"
                            placeholder="Write your task content here..."
                            oninput="updateTextareaStats('editDetailsInput', 'editWordCount', 'editCharCount')"
                        ><%= filedata || '' %></textarea>

                        <!-- Live Preview Box (hidden by default) -->
                        <div id="editLivePreview" class="content-viewer markdown-rendered" style="display:none; min-height: 240px;">
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="editor-footer" style="padding-top: 1rem; border-top: 1px solid var(--border-subtle);">
                        <div class="char-counter">
                            <span id="editWordCount">0 words</span>
                            <span>&bull;</span>
                            <span id="editCharCount">0 chars</span>
                        </div>

                        <div class="form-actions">
                            <a href="/file/<%= encodeURIComponent(filename) %>" class="btn btn-secondary btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <!-- Client-side Interactive Engine -->
    <script src="/js/app.js"></script>
    <script>
        function toggleEditPreview(mode) {
            const textarea = document.getElementById('editDetailsInput');
            const toolbar = document.getElementById('editToolbar');
            const preview = document.getElementById('editLivePreview');
            const tabEditor = document.getElementById('tabEditor');
            const tabPreview = document.getElementById('tabPreview');

            if (mode === 'preview') {
                textarea.style.display = 'none';
                toolbar.style.display = 'none';
                preview.style.display = 'block';
                tabPreview.classList.add('active');
                tabEditor.classList.remove('active');

                const content = textarea.value;
                if (content.trim()) {
                    preview.innerHTML = parseMarkdown(content);
                } else {
                    preview.innerHTML = '<p style="color:var(--text-muted); font-style:italic;">(Nothing to preview)</p>';
                }
            } else {
                textarea.style.display = 'block';
                toolbar.style.display = 'flex';
                preview.style.display = 'none';
                tabEditor.classList.add('active');
                tabPreview.classList.remove('active');
                textarea.focus();
            }
        }

        // Initialize counters on load
        document.addEventListener('DOMContentLoaded', () => {
            updateTextareaStats('editDetailsInput', 'editWordCount', 'editCharCount');
        });

        // Ctrl+S / Cmd+S save shortcut
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                e.preventDefault();
                document.getElementById('editTaskForm').submit();
            }
        });
    </script>
</body>
</html>
